# Copy this file to .env and fill in the values. Never commit .env.
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
OPENAI_MAX_TOKENS=1024
OPENAI_JSON_MODE=true
# DeepSeek supports enabled/disabled. Remove this line for other providers.
OPENAI_THINKING=disabled
# Read-only combat simulation function calling; disable for incompatible endpoints.
OPENAI_FUNCTION_CALLING=true
# OpenCode Go 套餐：设为 true 时发送 opencode 专用请求头
# （User-Agent 标识客户端 + 每会话稳定的 x-opencode-session）。
# 同时把 OPENAI_BASE_URL 设为 https://opencode.ai/inference/go/openai/v1
OPENCODE_MODE=false
